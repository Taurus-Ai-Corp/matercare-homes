# MaterCare Homes - Environment Variables
# ======================================

# Model
MATERCARE_MODEL=Taurus-AI-Corp/matercare-llama-3.2-3b

# HuggingFace
HUGGINGFACE_API_TOKEN=your_token_here

# API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Twilio Alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBER=

# Database
DATABASE_URL=postgresql://user:pass@localhost/matercare

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
